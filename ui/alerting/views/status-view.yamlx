################################################################################
# Alerting Status
################################################################################
title: STATUS
path: status
type: sections
max_columns: 2
# ################################################################################
# header:
#   layout: left
#   badges_position: top
#   badges_wrap: wrap
#   card:
#     type: markdown
#     content: |-
#       {% set p1 = states('sensor.active_p1_alerts') | int(0) %}
#       {% set p2 = states('sensor.active_p2_alerts') | int(0) %}
#       {% set p3 = states('sensor.active_p3_alerts') | int(0) %}
#       {% if p1 > 0 %}
#       # 🚨🚨🚨 STATUS CRITICAL 🚨🚨🚨
#       ## {{ p1 }} Critical alert{{ 's' if p1 > 1 else '' }} • {{ relative_time(states.sensor.active_p1_alerts.last_changed) }} ago

#       {% elif p2 > 0 %}
#       # ⚠️⚠️⚠️ WARNING ⚠️⚠️⚠️
#       ## {{ p2 }} Warning{{ 's' if p2 > 1 else '' }} • {{ relative_time(states.sensor.active_p2_alerts.last_changed) }} ago

#       {% elif p3 > 0 %}
#       # ℹ️ℹ️ SYSTEM INFORMATION ℹ️ℹ️
#       ## {{ p3 }} Informational Alert{{ 's' if p3 > 1 else '' }} • {{ relative_time(states.sensor.active_p3_alerts.last_changed) }} ago

#       {% else %}
#       # ✅✅✅ SYSTEMS NORMAL ✅✅✅
#       ## No active alerts 😍
#       {% endif %}

